# /etc/systemd/system/homelab-firewall.service
# Loads /etc/homelab/homelab.nft at boot, before the network comes up.
# Same ordering as Debian's nftables.service, but without "flush ruleset".
[Unit]
Description=Homelab nftables rules (host filter + NAT for vmbr1)
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/homelab/homelab.nft
ExecReload=/usr/sbin/nft -f /etc/homelab/homelab.nft
ExecStop=/usr/sbin/nft delete table inet homelab

[Install]
WantedBy=sysinit.target
