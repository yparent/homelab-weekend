# /etc/network/interfaces - OVHcloud Eco / Kimsufi, "Proxmox VE 9" template
#
# The OVH template already creates vmbr0, bridged on the physical NIC and
# carrying the public IP. DO NOT TOUCH IT: keep the lines generated by OVH.
# You only ADD vmbr1 at the end of the file.
#
# Same logic as Hetzner: one public IPv4, so the VMs live on a private bridge
# and go out through the host NAT (host/firewall/homelab.nft, with WAN = "vmbr0").
#
# Apply: ifreload -a

# ---- generated by OVH: keep as is (example only) ----
# auto lo
# iface lo inet loopback
#
# auto vmbr0
# iface vmbr0 inet static
#     address 198.51.100.20/24
#     gateway 198.51.100.254
#     bridge-ports eno1
#     bridge-stp off
#     bridge-fd 0
# ---- end of the OVH part ----

# Private bridge for the VMs.
auto vmbr1
iface vmbr1 inet static
    address 10.10.10.1/24
    bridge-ports none
    bridge-stp off
    bridge-fd 0
