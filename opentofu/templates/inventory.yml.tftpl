---
# Generated by OpenTofu (opentofu/inventory.tf). Do not edit by hand:
# change opentofu/variables.tf or terraform.tfvars, then run "tofu apply".
all:
  vars:
    ansible_user: ${vm_username}
  children:
%{ for g in groups ~}
    ${g}:
      hosts:
%{ for name, h in hosts ~}
%{ if contains(h.groups, g) ~}
        ${name}:
          ansible_host: ${h.ip}
%{ endif ~}
%{ endfor ~}
%{ endfor ~}
