# Template of secrets/tofu.enc.env (OpenTofu -> Proxmox API).
# Never commit the clear-text version. Create the encrypted file with:
#   cp secrets/tofu.env.example secrets/tofu.env   (clear text, ignored by Git)
#   sops encrypt --filename-override secrets/tofu.enc.env secrets/tofu.env > secrets/tofu.enc.env
#   shred -u secrets/tofu.env
# Edit it later with: sops edit secrets/tofu.enc.env
PROXMOX_VE_ENDPOINT=https://10.10.10.1:8006/
PROXMOX_VE_API_TOKEN=tofu@pve!homelab=00000000-0000-0000-0000-000000000000
PROXMOX_VE_INSECURE=true
