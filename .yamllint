---
# Compatible with ansible-lint (it reuses this file).
extends: default

ignore: |
  .terraform/
  ansible/.ansible/
  kubeconfig/

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  document-start: disable
